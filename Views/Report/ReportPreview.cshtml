@model IEnumerable<ASPNETWebAppMVCStudentApp.Enrollments>

@{
    ViewBag.Title = "Report Preview";
}

<div class="container mt-4">
    <h2>Student List for Course: @ViewBag.CourseTitle</h2>
    <hr />

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Students.StudentID</td>
                    <td>@item.Students.FirstName</td>
                    <td>@item.Students.LastName</td>
                    <td>@item.Grade</td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("Index", "Report")" class="btn btn-secondary">Quay lại chọn khóa học</a>
    <button onclick="window.print();" class="btn btn-success">In báo cáo</button>
</div>